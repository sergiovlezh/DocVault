# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (used by Docker Compose and backend)
POSTGRES_USER=docvault
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=docvault
DATABASE_URL=postgresql+asyncpg://docvault:change_me_in_local_env@db:5432/docvault

# Authentication (generate a real key with: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_a_long_random_secret_key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage & Uploads
STORAGE_BACKEND=local
STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=25